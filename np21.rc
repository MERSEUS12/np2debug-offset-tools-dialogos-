IDD_SCENEDLG DIALOG 0, 0, 252, 230
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_CAPTION | WS_POPUP | WS_SYSMENU
CAPTION "Go to scene"
FONT 8, "MS Shell Dlg"
{
    LTEXT           "Scene file (e.g. H14_R07.BIN):", -1, 8, 6, 178, 8, SS_LEFT
    EDITTEXT        IDC_SCENE_NAME, 8, 16, 100, 12, ES_AUTOHSCROLL
    LTEXT           "Dialogue # (decimal, 0 = first):", -1, 8, 34, 178, 8, SS_LEFT
    EDITTEXT        IDC_SCENE_DLG, 8, 44, 50, 12, ES_AUTOHSCROLL
    LTEXT           "Then skip N dialogues (decimal):", -1, 8, 62, 178, 8, SS_LEFT
    EDITTEXT        IDC_SCENE_SKIP, 8, 72, 50, 12, ES_AUTOHSCROLL
    LTEXT           "...or stop at script offset (hex):", -1, 70, 62, 120, 8, SS_LEFT
    EDITTEXT        IDC_SCENE_OFF, 70, 72, 50, 12, ES_AUTOHSCROLL
    LTEXT           "Script segment (hex):", -1, 8, 90, 100, 8, SS_LEFT
    EDITTEXT        IDC_SCENE_SEG, 8, 100, 50, 12, ES_AUTOHSCROLL
    CONTROL         "Also press Enter in maps / menus (tries to pass them)", IDC_SCENE_MASH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 70, 102, 174, 10
    PUSHBUTTON      "Refresh log", IDC_SCENE_REFRESH, 8, 120, 60, 14
    EDITTEXT        IDC_SCENE_INFO, 8, 140, 236, 86, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "Go", IDOK, 194, 7, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 194, 23, 50, 14
}